[[0.3, 3.7079999999999997, "國中畢業，下一步要去哪裡？"], [3.8579999999999997, 6.954, "選擇四維，大有可為！"], [7.8, 10.992, "綜合高中，高一先探索，"], [11.142, 14.358, "高二再選適合自己的學程。"], [15.3, 19.572000000000003, "商業、工業、觀光餐飲，三大類七個學程，"], [19.722, 21.978, "動手學、考證照！"], [22.8, 24.744, "想拚升學？"], [24.894000000000002, 28.470000000000002, "普通科，一路陪你衝刺繁星。"], [30.3, 34.332, "115 年繁星推薦，大學 19 人、科大 13 人，"], [34.482, 37.482, "台大、政大、臺科大都有學長姐！"], [37.8, 41.111999999999995, "在四維，老師不只教課本，"], [41.262, 44.094, "更陪你走過每一個難關。"], [45.3, 52.2, "（此處放學生受訪原音）"], [52.8, 57.215999999999994, "免試早鳥專案報名中！追蹤臉書「四維大小事」，"], [57.366, 59.478, "三年後，換你發光！"]]