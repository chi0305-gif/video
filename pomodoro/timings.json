[
 {
  "start": 0.25,
  "end": 2.962,
  "text": "只用一分鐘，看懂背後原理。"
 },
 {
  "start": 3.112,
  "end": 7.048,
  "text": "被打斷一次，你可能要二十多分鐘，才找回專注！"
 },
 {
  "start": 7.75,
  "end": 11.278,
  "text": "想像你正在讀書：手機一亮、訊息一跳，"
 },
 {
  "start": 11.428,
  "end": 14.452,
  "text": "注意力就像水管被戳了洞，一直漏。"
 },
 {
  "start": 15.25,
  "end": 18.106,
  "text": "心理學把這叫做「警覺性遞減」："
 },
 {
  "start": 18.256,
  "end": 22.096,
  "text": "長時間做同一件事，專注表現會慢慢往下掉。"
 },
 {
  "start": 22.75,
  "end": 25.822,
  "text": "問題來了：硬撐不休息，越讀越累；"
 },
 {
  "start": 25.972,
  "end": 29.884,
  "text": "可是一休息，又停不下來。到底該怎麼辦？"
 },
 {
  "start": 30.25,
  "end": 33.802,
  "text": "2011 年有一項實驗發現：在長時間任務中，"
 },
 {
  "start": 33.952,
  "end": 37.288,
  "text": "穿插短暫的轉換，表現反而比較不會下滑。"
 },
 {
  "start": 37.75,
  "end": 41.686,
  "text": "番茄鐘就是解法：專心 25 分鐘，休息 5 分鐘；"
 },
 {
  "start": 41.836,
  "end": 44.692,
  "text": "每做完四輪，再好好休息久一點。"
 },
 {
  "start": 45.25,
  "end": 48.418,
  "text": "原理有三個：有時限，比較好開始；"
 },
 {
  "start": 48.568,
  "end": 52.0,
  "text": "計時中不分心；定時休息，減少疲勞。"
 },
 {
  "start": 52.75,
  "end": 55.942,
  "text": "重點：專注要分段，休息要規律。"
 },
 {
  "start": 56.092,
  "end": 59.644,
  "text": "想一想：25 分鐘，真的最適合你嗎？"
 }
]